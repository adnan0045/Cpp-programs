#include <iostream>
using namespace std;

void stareCaseSearch (int arr[][4],int n, int m,int key){
    int i=0,j=m-1;
    while (i<n && j>=0){
        if (arr[i][j]==key){
            cout<<"Found at ("<<i<<","<<j<<")"<<endl;
            return;
        }else if(arr[i][j]>key){
            j--;
        }else{
            i++;
        }
    }
    cout<<"Key not found!!!";
}
int main() {
    int arr [][4] = {{10,20,30,40},
                    {15,25,35,45},
                    {27,29,37,48},
                    {32,33,39,50}};
    int n=4,m=4,key;
    cout<<"Enter your key: "<<endl;
    cin>>key;
    stareCaseSearch (arr,n,m,key);

    return 0;
}
