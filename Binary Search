#include <iostream>
using namespace std;

int binarySearch(int *arr,int n, int key){
    int st = 0,end = n-1;
    while (st <= end){
        int mid = (st+end)/2;
        if (arr[mid] == key){
            return mid;
        }else if(arr[mid]<key){
            st = mid+1;
        }else{
            end = mid-1;
        }
    }
    return -1;
}
int main() {
    int n;
    cout<<"Enter the size of the array:"<<endl;
    cin>>n;
    int arr[n];
    cout<<"Enter the elements of the array in ascending order:"<<endl;
    for (int i=0;i<n;i++){
        cin>>arr[i];
    }
    int key;
    cout<<"Enter your key:"<<endl;
    cin>>key;
    cout<<"Result:"<<endl;
    cout<<binarySearch(arr,n,key);
    
    return 0;
}
