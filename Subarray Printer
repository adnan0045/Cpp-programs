#include <iostream>
using namespace std;
void subarrayPrinter(int *arr, int n){
for(int start=0;start<n;start++){
    for(int end=start;end<n;end++){
        for (int i=start;i<=end;i++){
            cout<<arr[i];
        }
        cout<<" ";
    }
}
}
int main(){
int n;
cout<<"Enter the size of array"<<endl;
cin>>n;
int arr[n];
cout<<"Enter the array element:"<<endl;
for (int i=0;i<n;i++){
    cin>>arr[i];
}
subarrayPrinter(arr,n);
    return 0;
}
