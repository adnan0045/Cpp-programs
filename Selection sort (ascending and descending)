#include <iostream>
using namespace std;
void printer(int arr[],int n){
    for (int i=0;i<n;i++){
        cout<<arr[i]<<", ";
    }
}
void selectionSortAscending (int arr[],int n){
    for (int i=0;i<n-1;i++){
        int minInd=i;
        for (int j=i+1;j<n;j++){
            if (arr[j]<arr[minInd]){
                minInd=j;
            }
        }
        swap(arr[i],arr[minInd]);
    }
    printer(arr,n);
}
void selectionSortDescending (int arr[],int n){
    for (int i=0;i<n-1;i++){
        int maxInd=i;
        for (int j=i+1;j<n;j++){
            if (arr[j]>arr[maxInd]){
                maxInd=j;
            }
        }
        swap(arr[i],arr[maxInd]);
    }
    printer(arr,n);
}
int main(){
int n;
cout<<"Enter the size of array:"<<endl;
cin>>n;
int arr[n];
cout<<"Enter the array element:"<<endl;
for (int i=0;i<n;i++){
    cin>>arr[i];
}
cout<<"Ascending order:"<<endl;
selectionSortAscending(arr,n);
cout<<endl;
cout<<"Descending order:"<<endl;
selectionSortDescending(arr,n);
    return 0;
}
